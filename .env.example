# =============================================================================
# FitTrack Pro — Environment Variables
# =============================================================================
# Másold át ezt a fájlt `.env.local` néven (helyi fejlesztés) vagy add hozzá
# az értékeket a Vercel Project Settings → Environment Variables felületen
# (production deployment).
#
# A `NEXT_PUBLIC_` prefixű változók a böngészőbe is kibundle-olódnak — ezeket
# soha ne töltsd fel titkos kulcsként. A többi változó kizárólag szerver
# oldali kódból érhető el (API route, Server Action, middleware).
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase (kötelező)
# -----------------------------------------------------------------------------
# Forrás: Supabase Dashboard → Project Settings → API
#   - Project URL                  →  NEXT_PUBLIC_SUPABASE_URL
#   - Project API keys → anon public →  NEXT_PUBLIC_SUPABASE_ANON_KEY
#   - Project API keys → service_role → SUPABASE_SERVICE_ROLE_KEY
#
# A service_role kulcs minden RLS policy-t kikerül, ezért TILOS bárhol kliens
# oldali kódba kerülnie. Csak: scripts/*, /api/webhooks/stripe.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# OpenRouter — heti AI elemzés (kötelező az AI funkció használatához)
# -----------------------------------------------------------------------------
# Forrás: https://openrouter.ai/keys
#   1. Hozz létre egy fiókot (akár GitHub bejelentkezéssel).
#   2. Generálj egy API kulcsot a "Keys" oldalon.
#   3. A használt modell: `nvidia/nemotron-3-super-120b-a12b:free`
#      (lásd src/app/api/analysis/route.ts) — ehhez nem kell credit-feltöltés.
#
# A kulcs csak szerver oldalon használt (POST /api/analysis), a kliens
# bundle nem látja.
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...


# -----------------------------------------------------------------------------
# Stripe — webshop checkout (kötelező a Shop funkcióhoz)
# -----------------------------------------------------------------------------
# Forrás: https://dashboard.stripe.com/test/apikeys (Test mode!)
#   - Publishable key   →  NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (`pk_test_...`)
#   - Secret key        →  STRIPE_SECRET_KEY                  (`sk_test_...`)
#
# Webhook secret: Dashboard → Developers → Webhooks
#   1. Hozz létre egy endpoint-ot a `<deployment_url>/api/webhooks/stripe`
#      URL-re.
#   2. Eseménytípus: `checkout.session.completed`.
#   3. A létrehozás után másold ki a "Signing secret" értéket → STRIPE_WEBHOOK_SECRET.
#
# Helyi fejlesztéshez a Stripe CLI ajánlott:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# A CLI a saját whsec_ értékét írja ki a terminálba — azt tedd
# STRIPE_WEBHOOK_SECRET-be lokálisan.
#
# Az alkalmazás kizárólag Stripe TEST módban működik (a HUF currency miatt
# a price_data unit_amount mező a forint érték). Ne használj live kulcsokat.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...


# -----------------------------------------------------------------------------
# Site URL (opcionális; production deployment esetén ajánlott)
# -----------------------------------------------------------------------------
# A Vercel automatikusan beállítja a VERCEL_URL környezeti változót minden
# deployment-re. Ha custom domain-t használsz, akkor a Supabase Auth
# konfigurációjához (Site URL + Redirect URLs) is be kell ezt írni a
# Supabase Dashboard-on, lásd: docs/DEPLOYMENT.md.
#
# Ezt az értéket az analysis route is használhatja (HTTP-Referer header
# az OpenRouter requestnél), illetve a Stripe success/cancel URL-eknél a
# request `Origin` headerrel resolválódik, így ennek megadása opcionális.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://fittrack-pro.vercel.app
